---
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getTagUrl } from "../utils/url-utils";

interface Props {
	class?: string;
	published: Date;
	updated?: Date;
	tags?: string[];
	category?: string | null;
	hideTagsForMobile?: boolean;
	hideUpdateDate?: boolean;
	workspaceSlug?: string;
}

const {
	published,
	updated,
	tags = [],
	category = null,
	hideTagsForMobile = false,
	hideUpdateDate = false,
	workspaceSlug,
} = Astro.props;

const className = Astro.props.class;

// When inside a workspace, links must point to workspace-scoped archive routes.
const resolvedCategoryUrl = (cat: string | null): string => {
	if (workspaceSlug) {
		const archiveBase = `/w/${workspaceSlug}/archive/`;
		const trimmed = cat?.trim() ?? "";
		if (
			!trimmed ||
			trimmed.toLowerCase() === i18n(I18nKey.uncategorized).toLowerCase()
		) {
			return `${archiveBase}?uncategorized=true`;
		}
		return `${archiveBase}?category=${encodeURIComponent(trimmed)}`;
	}
	return getCategoryUrl(cat);
};

const resolvedTagUrl = (tag: string): string => {
	if (workspaceSlug) {
		const archiveBase = `/w/${workspaceSlug}/archive/`;
		if (!tag) return archiveBase;
		return `${archiveBase}?tag=${encodeURIComponent(tag.trim())}`;
	}
	return getTagUrl(tag);
};
---

<div
  class:list={[
    "flex flex-wrap items-center gap-x-4 gap-y-2 text-neutral-500 dark:text-neutral-400",
    className,
  ]}
>
  <!-- Publish date -->
  <div class="flex items-center gap-1">
    <Icon
      name="material-symbols:calendar-today-outline-rounded"
      class="text-xl"
    />
    <span class="text-sm font-medium">
      {formatDateToYYYYMMDD(published)}
    </span>
  </div>

  <!-- Update date -->
  {!hideUpdateDate && updated && updated.getTime() !== published.getTime()
    ? (
      <div class="flex items-center gap-1">
        <Icon
          name="material-symbols:edit-calendar-outline-rounded"
          class="text-xl"
        />
        <span class="text-sm font-medium">
          {formatDateToYYYYMMDD(updated)}
        </span>
      </div>
    )
    : null}

  <!-- Category -->
  <div class="flex items-center gap-1">
    <Icon
      name="material-symbols:book-2-outline-rounded"
      class="text-xl"
    />
    <a
      href={resolvedCategoryUrl(category)}
      aria-label={`View all posts in the ${category ?? "uncategorized"} category`}
      class="transition text-sm font-medium whitespace-nowrap
             hover:text-[var(--primary)] dark:hover:text-[var(--primary)]"
    >
      {category ?? i18n(I18nKey.uncategorized)}
    </a>
  </div>

  <!-- Tags -->
  <div
    class:list={[
      "flex items-center gap-1",
      hideTagsForMobile ? "hidden md:flex" : "flex",
    ]}
  >
    <Icon
      name="material-symbols:tag-rounded"
      class="text-xl"
    />

    {tags.length > 0 ? (
      <div class="flex flex-wrap items-center">
        {tags.map((tag, i) => (
          <Fragment>
            {i !== 0 ? (
              <span class="mx-1.5 text-sm text-[var(--meta-divider)]">/</span>
            ) : null}

            <a
              href={resolvedTagUrl(tag)}
              aria-label={`View all posts with the ${tag} tag`}
              class="transition text-sm font-medium whitespace-nowrap
                     hover:text-[var(--primary)] dark:hover:text-[var(--primary)]"
            >
              {tag}
            </a>
          </Fragment>
        ))}
      </div>
    ) : (
      <span class="text-sm font-medium">
        {i18n(I18nKey.noTags)}
      </span>
    )}
  </div>
</div>
