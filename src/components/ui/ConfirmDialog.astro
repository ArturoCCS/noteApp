---
const {
	id,
	title,
	description,
	confirmText = "Confirmar",
	cancelText = "Cancelar",
	danger = false,
} = Astro.props;
---

<dialog
  id={id}
  class="rounded-xl p-0 backdrop:bg-black/80 bg-transparent"
>
  <form method="dialog" class="bg-white dark:bg-zinc-900 rounded-xl p-6 w-[22rem] shadow-xl">
    <h3 class="text-lg text-black/60 dark:text-white/80 font-bold mb-2">{title}</h3>
    <p class="text-sm text-black/60 dark:text-white/70 mb-5">
      {description}
    </p>

    <div class="flex justify-end gap-3">
      <button value="cancel" class="px-4 py-2 rounded-md  text-black/60 dark:text-white/80 hover:bg-black/10 dark:hover:bg-white/30 transition">
        {cancelText}
      </button>

      <button
        value="confirm"
        class={`px-4 py-2 rounded-md text-white transition ${
          danger ? "bg-red-700 hover:bg-red-800" : "bg-primary hover:bg-blue-600"
        }`}
      >
        {confirmText}
      </button>
    </div>
  </form>
</dialog>

<script is:inline define:vars={{ id }}>
  function initDialog() {
    window.openConfirmDialog = (onConfirm) => {
      const dialog = document.getElementById(id);
      if (!dialog) return;

      dialog.showModal();
      
      const handleClose = async () => {
        if (dialog.returnValue === "confirm") {
          await onConfirm();
        }
        dialog.returnValue = "";
        dialog.removeEventListener("close", handleClose);
      };

      dialog.addEventListener("close", handleClose);
    };
  }

  initDialog();
  document.addEventListener("astro:page-load", initDialog);
</script>