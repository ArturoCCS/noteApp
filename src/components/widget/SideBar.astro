---
import type { MarkdownHeading } from "astro";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import Tag from "./Tags.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
	workspaceSlug?: string;
}

const className = Astro.props.class;
const { workspaceSlug } = Astro.props;
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile workspaceSlug={workspaceSlug}></Profile>
    </div>
    <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 sticky top-4">
        <Categories class="onload-animation" style="animation-delay: 150ms" workspaceSlug={workspaceSlug}></Categories>
        <Tag class="onload-animation" style="animation-delay: 200ms" workspaceSlug={workspaceSlug}></Tag>
    </div>
</div>
