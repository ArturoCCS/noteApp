---

import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { getTagList } from "../../server/firebase/get-posts";
import { getTagUrl } from "../../utils/url-utils";
import ButtonTag from "../control/ButtonTag.astro";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
	workspaceSlug?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
const { workspaceSlug } = Astro.props;

const tags = await getTagList(workspaceSlug);

const COLLAPSED_HEIGHT = "7.5rem";

const isCollapsed = tags.length >= 20;

const getWorkspaceTagUrl = (tag: string) => {
	if (workspaceSlug) {
		if (!tag) return `/w/${workspaceSlug}/archive/`;
		return `/w/${workspaceSlug}/archive/?tag=${encodeURIComponent(tag.trim())}`;
	}
	return getTagUrl(tag);
};
---
<WidgetLayout name={i18n(I18nKey.tags)} id="tags" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT} class={className} style={style}>
    <div class="flex gap-2 flex-wrap">
        {tags.map(t => (
            <ButtonTag href={getWorkspaceTagUrl(t.name)} label={`View all posts with the ${t.name.trim()} tag`}>
                {t.name.trim()}
            </ButtonTag>
        ))}
    </div>
</WidgetLayout>