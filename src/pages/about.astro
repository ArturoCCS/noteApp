---
export const prerender = false;
import { db } from "@/server/firebase/admin";
import AboutInlineEditor from "@components/AboutContentToggle";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const docSnap = await db.collection("pages").doc("about").get();

if (!docSnap.exists) {
  throw new Error("About page content not found in Firestore");
}

const content = docSnap.data()?.content ?? "";

import MarkdownIt from "markdown-it";

const md = new MarkdownIt({
  html: true,
  linkify: true,
  typographer: true,
});

const htmlContent = md.render(content || "");

---
<MainGridLayout
  title={i18n(I18nKey.about)}
  description={i18n(I18nKey.about)}
>
  <div class="about-card">
        
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div id="post-container" class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">
            
            <Markdown class="mb-6 markdown-content onload-animation">
                <article set:html={htmlContent} />
            </Markdown>

            
        </div>
    </div>
    <AboutInlineEditor
        client:only="react"
        initialContent={content}
    />

  </div>
</MainGridLayout>
