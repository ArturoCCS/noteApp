---
export const prerender = false;

import AboutInlineEditor from "@components/AboutContentToggle";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import MarkdownIt from "markdown-it";
import { requireAdmin } from "@/server/firebase/auth";
import {
	getWorkspaceAbout,
	getWorkspaceBySlug,
} from "@/server/firebase/get-workspace";

const auth = await requireAdmin(Astro.request);
if (!auth.ok) return Astro.redirect("/admin/login/");
if (!auth.workspaceSlug) throw new Error("Missing workspaceSlug claim");

const [aboutContent, workspace] = await Promise.all([
	getWorkspaceAbout(auth.workspaceSlug),
	getWorkspaceBySlug(auth.workspaceSlug),
]);

const md = new MarkdownIt({ html: true, linkify: true, typographer: true });
const htmlContent = aboutContent ? md.render(aboutContent) : "";
---

<MainGridLayout
  title={`Acerca de · ${workspace?.site?.title ?? auth.workspaceSlug}`}
  description={workspace?.site?.subtitle ?? ""}
  workspaceSlug={auth.workspaceSlug}
>
  <!-- Breadcrumb -->
  <div class="flex items-center gap-2 mb-4 px-1 onload-animation">
    <a href="/admin/" class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--primary)]/10 border border-[var(--primary)]/20 text-sm text-[var(--primary)] font-medium hover:bg-[var(--primary)]/20 transition">
      <Icon name="material-symbols:workspaces-outline" class="text-base" />
      <span>@{auth.workspaceSlug}</span>
    </a>
    <span class="text-sm text-black/40 dark:text-white/40">· Acerca de</span>
  </div>

  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
    <div class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">
      <Markdown class="mb-6 markdown-content onload-animation">
        {aboutContent
          ? <article set:html={htmlContent} />
          : <p class="text-black/40 dark:text-white/40 italic">Este workspace aún no tiene una página de presentación.</p>
        }
      </Markdown>

      <AboutInlineEditor
        client:only="react"
        initialContent={aboutContent}
      />
    </div>
  </div>

  <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full onload-animation">
    <a href="/admin/" class="w-full font-bold overflow-hidden active:scale-95">
      <div class="btn-card rounded-2xl w-full h-[3.75rem] px-4 flex items-center gap-4">
        <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-[var(--primary)]" />
        <div class="text-black/75 dark:text-white/75">Volver al inicio</div>
      </div>
    </a>
  </div>
</MainGridLayout>
