---
export const prerender = false;

import PostEditor from "@/components/PostEditor";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { requireAdmin } from "@/server/firebase/auth";
import { getPostBySlug } from "@/server/firebase/get-posts";

const auth = await requireAdmin(Astro.request);
if (!auth.ok) return Astro.redirect("/admin/login/");
if (!auth.workspaceSlug) throw new Error("Missing workspaceSlug claim");

const { slug } = Astro.params;
if (!slug) throw new Error("Missing slug");

const post = await getPostBySlug(auth.workspaceSlug, slug);
if (!post) return Astro.redirect("/admin/");
---
<MainGridLayout title="Editar post" description="Editar post" isAdmin={true}>
  <div class="card-base p-6">
    <PostEditor client:only="react" post={post} workspaceSlug={auth.workspaceSlug} />
  </div>
</MainGridLayout>