---
export const prerender = false;

import PostMetadata from "@components/PostMeta.astro";
import { PAGE_SIZE } from "@constants/constants";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { requireAdmin } from "@/server/firebase/auth";
import { getSortedPosts } from "@/server/firebase/get-posts";
import { getWorkspaceBySlug } from "@/server/firebase/get-workspace";

const auth = await requireAdmin(Astro.request);
if (!auth.ok) return Astro.redirect("/admin/login/");
if (!auth.workspaceSlug) throw new Error("Missing workspaceSlug claim");

const currentPage = Number(Astro.url.searchParams.get("page") ?? 1);
const allPosts = await getSortedPosts(auth.workspaceSlug);

const total = allPosts.length;
const lastPage = Math.max(1, Math.ceil(total / PAGE_SIZE));
const start = (currentPage - 1) * PAGE_SIZE;
const end = Math.min(start + PAGE_SIZE, total);
const posts = allPosts.slice(start, end);

const workspace = await getWorkspaceBySlug(auth.workspaceSlug);
const site = workspace?.site;
const profile = workspace?.profile;
---

<MainGridLayout
  title={site?.title || "Admin"}
  description={site?.subtitle || ""}
  workspaceSlug={auth.workspaceSlug}
>
  <!-- Admin action bar -->
  <div class="flex items-center justify-between mb-4 px-1 onload-animation">
    <div class="flex items-center gap-2">
      <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--primary)]/10 border border-[var(--primary)]/20 text-sm text-[var(--primary)] font-medium">
        <Icon name="material-symbols:workspaces-outline" class="text-base" />
        <span>@{auth.workspaceSlug}</span>
      </div>
      {profile?.name && (
        <span class="text-sm text-black/40 dark:text-white/40">· {profile.name}</span>
      )}
    </div>
    <a class="btn-regular btn-plain px-5 h-9 rounded-[var(--radius-large)] text-sm font-medium" href="/admin/new/">
      + Nuevo
    </a>
  </div>

  <!-- Posts list -->
  <div class="transition flex flex-col rounded-[var(--radius-large)] bg-[var(--card-bg)] py-1 md:py-0 md:bg-transparent md:gap-4 mb-4">
    {posts.length === 0 && (
      <div class="card-base px-9 py-12 text-center text-black/40 dark:text-white/40">
        No hay publicaciones aún.
        <a href="/admin/new/" class="text-[var(--primary)] ml-1">Crea tu primer post</a>.
      </div>
    )}
    {posts.map((post) => {
      const published = post.published ? new Date(post.published) : new Date();
      return (
        <div class="card-base flex flex-col w-full rounded-[var(--radius-large)] overflow-hidden relative onload-animation">
          <div class="pl-6 md:pl-9 pr-6 md:pr-2 pt-6 md:pt-7 pb-6 relative w-full">
            <a
              href={`/admin/posts/${post.slug}/`}
              class="transition group w-full block font-bold mb-3 text-3xl text-90
                hover:text-[var(--primary)] dark:hover:text-[var(--primary)]
                active:text-[var(--title-active)]
                before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                before:absolute before:top-[35px] before:left-[18px] before:hidden md:before:block"
            >
              {post.title}
            </a>

            <PostMetadata
              published={published}
              tags={post.tags}
              category={post.category}
              hideTagsForMobile={true}
              hideUpdateDate={true}
              class="mb-4"
            />

            {post.description && (
              <div class="transition text-75 mb-3.5 pr-4 line-clamp-2 md:line-clamp-1">
                {post.description}
              </div>
            )}

            <div class="flex items-center justify-between">
              <div class="text-sm text-black/30 dark:text-white/30 flex gap-4 transition">
                <div>{post.words ?? 0} {i18n(I18nKey.wordsCount)}</div>
                <div>|</div>
                <div>{post.minutes ?? 1} {i18n(post.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}</div>
              </div>
              <a
                href={`/admin/edit/${post.slug}/`}
                class="text-xs text-[var(--primary)] opacity-70 hover:opacity-100 transition"
              >
                Editar
              </a>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Pagination -->
  {total > PAGE_SIZE && (
    <div class="flex justify-center gap-2 mt-4 onload-animation">
      {currentPage > 1 && (
        <a href={`/admin/?page=${currentPage - 1}`} class="btn-plain rounded-lg px-4 h-10 font-medium">
          ← Anterior
        </a>
      )}
      <span class="flex items-center px-4 text-sm text-black/50 dark:text-white/50">
        {currentPage} / {lastPage}
      </span>
      {currentPage < lastPage && (
        <a href={`/admin/?page=${currentPage + 1}`} class="btn-plain rounded-lg px-4 h-10 font-medium">
          Siguiente →
        </a>
      )}
    </div>
  )}

  <!-- Admin nav links -->
  <div class="mt-6 flex gap-4 px-1 onload-animation">
    <a class="link text-[var(--primary)]" href="/admin/about/">Acerca de</a>
    <span class="text-black/30 dark:text-white/30">·</span>
    <a class="link text-[var(--primary)]" href="/admin/archive/">Archivo</a>
    <span class="text-black/30 dark:text-white/30">·</span>
    <a class="link text-[var(--primary)]" href="/admin/workspace/">Configurar entorno</a>
  </div>
</MainGridLayout>
