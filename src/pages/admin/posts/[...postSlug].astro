---
export const prerender = false;

import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import PostMetadata from "@components/PostMeta.astro";
import StudyTools from "@components/study/StudyTools";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import MarkdownIt from "markdown-it";
import { requireAdmin } from "@/server/firebase/auth";
import { getPostBySlug } from "@/server/firebase/get-posts";
import { getWorkspaceBySlug } from "@/server/firebase/get-workspace";

const auth = await requireAdmin(Astro.request);
if (!auth.ok) return Astro.redirect("/admin/login/");
if (!auth.workspaceSlug) throw new Error("Missing workspaceSlug claim");

const { postSlug } = Astro.params as { postSlug: string | string[] };
const postSlugStr = Array.isArray(postSlug) ? postSlug.join("/") : postSlug;

if (!postSlugStr) return Astro.redirect("/admin/");

const [entry, workspace] = await Promise.all([
	getPostBySlug(auth.workspaceSlug, postSlugStr),
	getWorkspaceBySlug(auth.workspaceSlug),
]);

if (!entry) return Astro.redirect("/admin/");

const md = new MarkdownIt({ breaks: false, html: true });

const publishedDate = entry.published ? new Date(entry.published) : new Date();
const updatedDate = entry.updated ? new Date(entry.updated) : undefined;
const defaultLang = workspace?.site?.lang?.replace("_", "-") ?? "es";
const isStudy = entry.type === "study";
---

<MainGridLayout
  title={entry.title}
  description={entry.description}
  lang={defaultLang}
  setOGTypeArticle={false}
  workspaceSlug={auth.workspaceSlug}
>
  <!-- Breadcrumb -->
  <div class="flex items-center gap-2 mb-4 px-1 onload-animation">
    <a href="/admin/" class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--primary)]/10 border border-[var(--primary)]/20 text-sm text-[var(--primary)] font-medium hover:bg-[var(--primary)]/20 transition">
      <Icon name="material-symbols:workspaces-outline" class="text-base" />
      <span>@{auth.workspaceSlug}</span>
    </a>
  </div>

  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
    <div id="post-container" class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">
      <div class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation">
        <div class="flex flex-row items-center">
          <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
            <Icon name="material-symbols:notes-rounded" />
          </div>
          <div class="text-sm">
            {entry.words ?? 0} {i18n(I18nKey.wordsCount)}
          </div>
        </div>

        <div class="flex flex-row items-center">
          <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
            <Icon name="material-symbols:schedule-outline-rounded" />
          </div>
          <div class="text-sm">
            {entry.minutes ?? 1}
            {i18n(entry.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
          </div>
        </div>
      </div>

      <div class="relative onload-animation">
        <div
          class="transition w-full block font-bold mb-3
            text-3xl md:text-[2.25rem]/[2.75rem]
            text-black/90 dark:text-white/90
            md:before:w-1 before:h-5 before:rounded-md
            before:bg-[var(--primary)]
            before:absolute before:top-[0.75rem] before:left-[-1.125rem]"
        >
          {entry.title}
        </div>
      </div>

      <div class="onload-animation">
        <PostMetadata
          class="mb-5"
          published={publishedDate}
          updated={updatedDate}
          tags={entry.tags}
          category={entry.category}
        />
        {!entry.image && (
          <div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-5"></div>
        )}
      </div>

      <Markdown class="mb-6 markdown-content onload-animation">
        {isStudy && (
          <StudyTools client:load content={entry.content ?? ""} />
        )}
        <article set:html={md.render(entry.content ?? "")} />
      </Markdown>

      {workspace?.license?.enable && (
        <License
          title={entry.title}
          slug={entry.slug}
          pubDate={publishedDate}
          class="mb-6 rounded-xl license-container onload-animation"
        />
      )}
    </div>
  </div>

  <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full onload-animation">
    <a href="/admin/" class="w-full font-bold overflow-hidden active:scale-95">
      <div class="btn-card rounded-2xl w-full h-[3.75rem] px-4 flex items-center gap-4">
        <Icon
          name="material-symbols:chevron-left-rounded"
          class="text-[2rem] text-[var(--primary)]"
        />
        <div class="text-black/75 dark:text-white/75">
          Volver al inicio
        </div>
      </div>
    </a>
    <a href={`/admin/edit/${entry.slug}/`} class="w-full font-bold overflow-hidden active:scale-95">
      <div class="btn-card rounded-2xl w-full h-[3.75rem] px-4 flex items-center gap-4 justify-end">
        <div class="text-black/75 dark:text-white/75">
          Editar post
        </div>
        <Icon
          name="material-symbols:edit-outline-rounded"
          class="text-[2rem] text-[var(--primary)]"
        />
      </div>
    </a>
  </div>
</MainGridLayout>
