---
export const prerender = false;

import WorkspaceSettingsEditor from "@/components/WorkspaceSettingsEditor";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { requireAdmin } from "@/server/firebase/auth";

const auth = await requireAdmin(Astro.request);
if (!auth.ok) return Astro.redirect("/admin/login/");
---

<MainGridLayout title="Workspace" description="Workspace">
  <div class="card-base p-6">
    <h1 class="text-2xl font-bold mb-2">Configurar entorno</h1>
    <p class="text-sm opacity-70 mb-4">
      Cambia título, banner, perfil, navbar, licencia, y About.
    </p>
    <WorkspaceSettingsEditor client:only="react" />
  </div>
</MainGridLayout>