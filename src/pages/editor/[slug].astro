---
import PostEditor from "@components/PostEditor";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getAdminUser } from "@/server/firebase/auth";
import { getPostById } from "@/server/firebase/get-posts";

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
	throw new Error("Slug no proporcionado");
}

// Try to resolve the composite id using the admin session first (new posts)
let post = null;
const admin = await getAdminUser(Astro.request);
if (admin?.workspaceSlug) {
	const compositeId = `${admin.workspaceSlug}__${slug}`;
	post = await getPostById(compositeId);
}

// Fall back to a direct id lookup (legacy posts or composite id passed directly)
if (!post) {
	post = await getPostById(slug);
}

if (!post) {
	throw new Error("Post no encontrado");
}
---
<MainGridLayout>
  <PostEditor client:only="react" post={post} />

</MainGridLayout>
