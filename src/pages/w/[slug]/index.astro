---
export const prerender = false;

import Pagination from "@components/control/Pagination.astro";
import PostPage from "@components/PostPage.astro";
import { PAGE_SIZE } from "@constants/constants";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/server/firebase/get-posts";
import { getWorkspaceBySlug } from "@/server/firebase/get-workspace";

const { slug } = Astro.params as { slug: string };

const workspace = await getWorkspaceBySlug(slug);

if (!workspace || !workspace.isPublic) {
	return Astro.redirect("/404");
}

const currentPage = Number(Astro.url.searchParams.get("page") ?? 1);
const allPosts = await getSortedPosts(slug);

const total = allPosts.length;
const lastPage = Math.max(1, Math.ceil(total / PAGE_SIZE));
const start = (currentPage - 1) * PAGE_SIZE;
const end = Math.min(start + PAGE_SIZE, total);
const posts = allPosts.slice(start, end);

const baseUrl = `/w/${slug}/`;

// Build a Page-like object compatible with the Pagination and PostPage components
const page = {
	data: posts,
	currentPage,
	lastPage,
	url: {
		current: currentPage === 1 ? baseUrl : `${baseUrl}?page=${currentPage}`,
		prev: currentPage > 1 ? `${baseUrl}?page=${currentPage - 1}` : undefined,
		next:
			currentPage < lastPage ? `${baseUrl}?page=${currentPage + 1}` : undefined,
		first: baseUrl,
		last: lastPage > 1 ? `${baseUrl}?page=${lastPage}` : baseUrl,
	},
	// Unused by our components but required by the Page type interface
	start: start,
	end: end - 1,
	total,
	size: PAGE_SIZE,
};

const { site } = workspace;
---

<MainGridLayout
  title={site.title}
  description={site.subtitle}
  lang={site.lang}
  workspaceSlug={slug}
>
  {posts.length === 0 && (
    <div class="card-base px-9 py-12 text-center text-black/40 dark:text-white/40 mb-4">
      No hay publicaciones en este workspace aún.
    </div>
  )}

  <PostPage page={page} workspaceSlug={slug} />

  {total > PAGE_SIZE && (
    <Pagination page={page} baseUrl={baseUrl} class="onload-animation" />
  )}
</MainGridLayout>
